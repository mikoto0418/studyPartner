# Copy this file to local.tunnel.env and keep the real file private.
# Do not commit local.tunnel.env.

# Public hostname used by Vite dev server allowedHosts.
TUNNEL_HOSTNAME=study.example.com

# Cloudflared config path. This file usually contains tunnel id and credentials path.
CLOUDFLARED_CONFIG=%USERPROFILE%\.cloudflared\config-your-project.yml

# Optional cloudflared binary path. Leave empty to use cloudflared from PATH.
CLOUDFLARED_EXE=

# Local service ports used by the development startup scripts.
FRONTEND_PORT=5173
BACKEND_PORT=8001
