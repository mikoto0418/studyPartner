# ==========================================
# AI伴学与智能体协同平台 - 环境变量配置文件
# ==========================================

# ========== 核心应用配置 ==========
APP_NAME=AI伴学与智能体协同平台
APP_ENV=development
APP_DEBUG=true

# ========== 数据库 (PostgreSQL) ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=studypartner
POSTGRES_USER=studypartner
POSTGRES_PASSWORD=studypartner_secure_pass

# ========== 缓存与队列 (Redis) ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass
REDIS_DB=0

# ========== 关系型向量库 (Qdrant) ==========
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# ========== 对象存储 (MinIO) ==========
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=studypartner-files

# ========== 身份认证 (JWT) ==========
# 请在生产环境中生成一个强随机字符串：openssl rand -hex 32
JWT_SECRET_KEY=4eb8be4fbf0e854d92a106f376f9d784a3c2be3c16260840b2f56b5dfbc5eeaa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 硅基流动大模型 API ==========
# 注册并登录 https://sf.api.siliconflow.cn/ 获取免费API KEY
SILICONFLOW_API_KEY=sk-ofzicvdfyodoznhmzlddiqojzzfbgbqkkohtsidaughwxuqo
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ========== 外部邮件通知 (SMTP) ==========
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password_here

# ========== 协同通知 Webhooks ==========
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=

# ========== Cloudflare Tunnel 穿透 ==========
TUNNEL_TOKEN=
