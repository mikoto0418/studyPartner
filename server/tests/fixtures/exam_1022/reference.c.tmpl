#include <stdio.h>
#include <stdlib.h>
#define TASK __TASK__
int max(int a,int b){return a>b?a:b;}
int main(void){
    if(TASK==2){
        int n,l,r,counts[8]={0};scanf("%d",&n);
        unsigned char *walls=calloc(n,1);
        for(int b=0;b<3;b++){scanf("%d%d",&l,&r);for(int i=l-1;i<r;i++)walls[i]|=1<<b;}
        for(int i=0;i<n;i++)counts[walls[i]]++;
        counts[0]+=counts[7];int order[]={1,2,4,3,6,0,5};
        for(int i=0;i<7;i++)printf("%d%c",counts[order[i]],i==6?'\n':' ');
        free(walls);return 0;
    }
    if(TASK==3){
        int c;while((c=getchar())!=EOF && c!='\n' && c!='\r'){
            putchar(c>='a'&&c<='z'?c-'a'+'A':(c-'A'+1)%26+'A');
        }
        putchar('\n');return 0;
    }
    if(TASK==1){
        int start,end,found=0;
        scanf("%d%d",&start,&end);
        for(int y=start/10000;y<=end/10000;y++){
            int t=y,rev=0;
            for(int i=0;i<4;i++){rev=rev*10+t%10;t/=10;}
            int m=rev/100,d=rev%100,x=y*10000+rev;
            int days[]={0,31,28,31,30,31,30,31,31,30,31,30,31};
            if(y%400==0||(y%4==0&&y%100!=0))days[2]=29;
            if(m>=1&&m<=12&&d>=1&&d<=days[m]&&x>=start&&x<=end){printf("%08d\n",x);found=1;}
        }
        if(!found)puts("0");
    }else if(TASK==4){
        int n,l[7]={0},r[7]={0},top=1,far=0;scanf("%d",&n);
        for(int i=0;i<n;i++){
            int a,b;scanf("%d%d",&a,&b);
            b%=100;
            int x=(b+1)/2-(b<=20?11:10);
            l[a]=max(l[a],-x);r[a]=max(r[a],x);top=max(top,a);
            far=max(far,30*(a-1)+3*abs(x));
        }
        int sum=30*(top-1);for(int i=1;i<=6;i++)sum+=3*(l[i]+r[i]);
        printf("%d\n",2*sum-far);
    }else{
        int n,a[20],dp[20][20]={0};scanf("%d",&n);
        for(int i=0;i<n;i++){scanf("%d",&a[i]);dp[i][i]=a[i];}
        for(int len=2;len<=n;len++)for(int i=0;i+len<=n;i++){
            int j=i+len-1;dp[i][j]=max(a[i]-dp[i+1][j],a[j]-dp[i][j-1]);
        }
        puts(dp[0][n-1]>0?"A":dp[0][n-1]<0?"B":"F");
    }
    return 0;
}
