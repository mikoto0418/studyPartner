import java.io.*;
import java.time.*;
import java.util.*;
public class Main {
    static final int TASK=__TASK__;
    static class Input {
        final BufferedInputStream in=new BufferedInputStream(System.in);
        int next() throws IOException {
            int c;do{c=in.read();}while(c<=32&&c!=-1);
            int n=0;while(c>32&&c!=-1){n=n*10+c-'0';c=in.read();}return n;
        }
    }
    public static void main(String[] args) throws Exception {
        Input in=new Input();
        if(TASK==2){
            int n=in.next();int[] walls=new int[n],counts=new int[8];
            for(int b=0;b<3;b++){int l=in.next(),r=in.next();for(int i=l-1;i<r;i++)walls[i]|=1<<b;}
            for(int x:walls)counts[x]++;counts[0]+=counts[7];int[] order={1,2,4,3,6,0,5};
            StringBuilder result=new StringBuilder();
            for(int i=0;i<7;i++){if(i>0)result.append(' ');result.append(counts[order[i]]);}
            System.out.println(result);return;
        }
        if(TASK==3){
            String s=new BufferedReader(new InputStreamReader(System.in)).readLine();
            StringBuilder result=new StringBuilder(s.length());
            for(char c:s.toCharArray())result.append((char)(c>='a'&&c<='z'?c-'a'+'A':(c-'A'+1)%26+'A'));
            System.out.println(result);return;
        }
        if(TASK==1){
            int start=in.next(),end=in.next();boolean found=false;
            for(int y=start/10000;y<=end/10000;y++){
                String s=""+y+new StringBuilder(""+y).reverse();
                int m=Integer.parseInt(s.substring(4,6)),d=Integer.parseInt(s.substring(6)),x=Integer.parseInt(s);
                try{LocalDate.of(y,m,d);}catch(DateTimeException e){continue;}
                if(start<=x&&x<=end){System.out.println(s);found=true;}
            }
            if(!found)System.out.println(0);
        }else if(TASK==4){
            int n=in.next(),top=1,far=0;int[]l=new int[7],r=new int[7];
            for(int i=0;i<n;i++){
                int a=in.next(),b=in.next()%100,x=(b+1)/2-(b<=20?11:10);
                l[a]=Math.max(l[a],-x);r[a]=Math.max(r[a],x);top=Math.max(top,a);
                far=Math.max(far,30*(a-1)+3*Math.abs(x));
            }
            int sum=30*(top-1);for(int i=1;i<=6;i++)sum+=3*(l[i]+r[i]);
            System.out.println(2*sum-far);
        }else{
            int n=in.next();int[]a=new int[n];int[][]dp=new int[n][n];
            for(int i=0;i<n;i++){a[i]=in.next();dp[i][i]=a[i];}
            for(int len=2;len<=n;len++)for(int i=0;i+len<=n;i++){
                int j=i+len-1;dp[i][j]=Math.max(a[i]-dp[i+1][j],a[j]-dp[i][j-1]);
            }
            System.out.println(dp[0][n-1]>0?"A":dp[0][n-1]<0?"B":"F");
        }
    }
}
