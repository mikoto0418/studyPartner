#include <bits/stdc++.h>
using namespace std;
constexpr int TASK=__TASK__;
int main(){
    ios::sync_with_stdio(false);cin.tie(nullptr);
    if(TASK==2){
        int n;cin>>n;vector<int>walls(n);int counts[8]={};
        for(int b=0;b<3;b++){int l,r;cin>>l>>r;for(int i=l-1;i<r;i++)walls[i]|=1<<b;}
        for(int x:walls)counts[x]++;counts[0]+=counts[7];int order[]={1,2,4,3,6,0,5};
        for(int i=0;i<7;i++)cout<<counts[order[i]]<<(i==6?'\n':' ');return 0;
    }
    if(TASK==3){
        string s;cin>>s;for(char &c:s)c=(c>='a'&&c<='z')?c-'a'+'A':(c-'A'+1)%26+'A';
        cout<<s<<'\n';return 0;
    }
    if(TASK==1){
        int start,end;cin>>start>>end;bool found=false;
        for(int y=start/10000;y<=end/10000;++y){
            string s=to_string(y),t=s;reverse(t.begin(),t.end());s+=t;
            int m=stoi(s.substr(4,2)),d=stoi(s.substr(6)),x=stoi(s);
            int days[]={0,31,28,31,30,31,30,31,31,30,31,30,31};
            if(y%400==0||(y%4==0&&y%100!=0))days[2]=29;
            if(m>=1&&m<=12&&d>=1&&d<=days[m]&&x>=start&&x<=end){cout<<s<<'\n';found=true;}
        }
        if(!found)cout<<"0\n";
    }else if(TASK==4){
        int n,l[7]={},r[7]={},top=1,far=0;cin>>n;
        while(n--){
            int a,b;cin>>a>>b;b%=100;int x=(b+1)/2-(b<=20?11:10);
            l[a]=max(l[a],-x);r[a]=max(r[a],x);top=max(top,a);
            far=max(far,30*(a-1)+3*abs(x));
        }
        int sum=30*(top-1);for(int i=1;i<=6;++i)sum+=3*(l[i]+r[i]);
        cout<<2*sum-far<<'\n';
    }else{
        int n;cin>>n;vector<int>a(n);vector<vector<int>>dp(n,vector<int>(n));
        for(int i=0;i<n;++i){cin>>a[i];dp[i][i]=a[i];}
        for(int len=2;len<=n;++len)for(int i=0;i+len<=n;++i){
            int j=i+len-1;dp[i][j]=max(a[i]-dp[i+1][j],a[j]-dp[i][j-1]);
        }
        cout<<(dp[0][n-1]>0?'A':dp[0][n-1]<0?'B':'F')<<'\n';
    }
}
