# Local backend environment template.
# The real server/.env is ignored by Git and may contain private secrets.

APP_NAME=AI伴学与智能体协同平台
APP_ENV=development
APP_DEBUG=true
ENABLE_INLINE_SCHEDULER=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=studypartner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=studypartner-files

JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keep empty here. Configure real LLM keys in the admin model config page.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_API_KEY=
SILICONFLOW_CHAT_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_API_KEY=
SILICONFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
LLM_CHAT_TIMEOUT_SECONDS=60
LEARNING_PATH_LLM_TIMEOUT_SECONDS=90

# ========== 拆题大模型 API（OpenAI 兼容接口，仅作兜底） ==========
# 拆题的模型通道由管理端「模型配置」页面控制（task_type=question_parsing），
# 那里配了就优先用它，改完立刻生效。下面的变量只在管理端没有该任务的通道时
# 才被使用，属于首次部署的引导路径；正常情况下留空即可。
QUESTION_PARSING_API_KEY=
QUESTION_PARSING_BASE_URL=
QUESTION_PARSING_MODEL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
