# Local backend environment template.
# The real server/.env is ignored by Git and may contain private secrets.

APP_NAME=AI伴学与智能体协同平台
APP_ENV=development
APP_DEBUG=true
ENABLE_INLINE_SCHEDULER=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=studypartner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=studypartner-files

JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keep empty here. Configure real LLM keys in the admin model config page.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
